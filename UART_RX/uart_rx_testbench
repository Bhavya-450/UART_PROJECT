

`timescale 1ns/1ps

module uart_rx_tb;

    localparam CLK_FREQ  = 1_000_000;
    localparam BAUD_RATE = 100_000;
    localparam CLK_PERIOD  = 1000;
    localparam BAUD_PERIOD = 10000;

    reg        clk, rst_n;
    reg        rx_line;          // driven by testbench
    wire [7:0] rx_data;
    wire       rx_valid, rx_busy;

    // ---- Instantiate DUT ----
    uart_rx #(
        .CLK_FREQ (CLK_FREQ),
        .BAUD_RATE(BAUD_RATE)
    ) dut (
        .clk(clk), .rst_n(rst_n), .rx(rx_line),
        .rx_data(rx_data), .rx_valid(rx_valid), .rx_busy(rx_busy)
    );

    // ---- Clock ----
    initial clk = 0;
    always #(CLK_PERIOD/2) clk = ~clk;

    // ---- Task: drive one serial byte onto rx_line ----
    task drive_serial(input [7:0] data);
        integer i;
        begin
            rx_line = 1'b0;                 // START bit
            #(BAUD_PERIOD);

            for (i = 0; i < 8; i = i + 1) begin
                rx_line = data[i];          // LSB first
                #(BAUD_PERIOD);
            end

            rx_line = 1'b1;                 // STOP bit
            #(BAUD_PERIOD);
        end
    endtask

    // ---- Stimulus ----
    initial begin
        clk = 0; rst_n = 0; rx_line = 1;
        repeat (5) @(posedge clk);
        rst_n = 1;
        repeat (5) @(posedge clk);
        #(CLK_PERIOD/4);                    // avoid clock-edge race

        drive_serial(8'hA5);
        repeat (2) @(posedge clk);
        drive_serial(8'h3C);
        repeat (2) @(posedge clk);
        drive_serial(8'hFF);
        repeat (2) @(posedge clk);

        repeat (20) @(posedge clk);
        $finish;
    end

    // ---- Print received data ----
    always @(posedge clk) begin
        if (rx_valid)
            $display("[%0t] Received byte = 0x%02h", $time, rx_data);
    end

    initial begin
        #(BAUD_PERIOD * 100);
        $display("TIMEOUT!");
        $finish;
    end
endmodule
