//////////////////////////////////////////////////////////////////////////////////
`timescale 1ns/1ps

module uart_top_tb;

    localparam CLK_FREQ  = 1_000_000;
    localparam BAUD_RATE = 100_000;
    localparam CLK_PERIOD  = 1000;
    localparam BAUD_PERIOD = 10000;

    reg        clk, rst_n;
    reg        tx_start;
    reg  [7:0] tx_data;
    wire       tx_line;
    wire       tx_busy, tx_done;
    wire [7:0] rx_data;
    wire       rx_valid, rx_busy;

    reg  [7:0] sent_byte;

    // ---- Instantiate top with LOOPBACK ----
    uart_top #(
        .CLK_FREQ (CLK_FREQ),
        .BAUD_RATE(BAUD_RATE)
    ) dut (
        .clk      (clk),
        .rst_n    (rst_n),
        .tx_start (tx_start),
        .tx_data  (tx_data),
        .tx       (tx_line),
        .tx_busy  (tx_busy),
        .tx_done  (tx_done),
        .rx       (tx_line),       // <--- hardware loopback
        .rx_data  (rx_data),
        .rx_valid (rx_valid),
        .rx_busy  (rx_busy)
    );

    initial clk = 0;
    always #(CLK_PERIOD/2) clk = ~clk;

    // ---- Task: send a byte and wait for TX ----
    task send_byte(input [7:0] b);
        begin
            @(posedge clk);
            tx_data  = b;
            tx_start = 1'b1;
            @(posedge clk);
            tx_start = 1'b0;
            wait (tx_done);
            @(posedge clk);
        end
    endtask

    // ---- Stimulus ----
    integer i;
    initial begin
        clk = 0; rst_n = 0; tx_start = 0; tx_data = 0; sent_byte = 0;
        repeat (10) @(posedge clk);
        rst_n = 1;
        repeat (10) @(posedge clk);

        // Send 5 bytes one by one
        for (i = 0; i < 5; i = i + 1) begin
            sent_byte = i * 8'h11 + 8'h01;   // 01,12,23,34,45
            send_byte(sent_byte);
            // Wait for receiver to decode it
            wait (rx_valid);
            $display("[%0t] Sent=0x%02h  Received=0x%02h",
                     $time, sent_byte, rx_data);
            if (rx_data !== sent_byte)
                $display("  *** MISMATCH ***");
            @(posedge clk);
        end

        repeat (20) @(posedge clk);
        $display("Loopback test finished.");
        $finish;
    end

    initial begin
        #(BAUD_PERIOD * 200);
        $display("TIMEOUT!");
        $finish;
    end
endmodule
