//////////////////////////////////////////////////////////////////////////////////
`timescale 1ns/1ps

module uart_top_tb;

    parameter integer CLK_FREQ  = 1_000_000;
    parameter integer BAUD_RATE = 9_600;

    reg        clk;
    reg        rst_n;
    reg [7:0]  tx_data_in;
    reg        tx_start;

    wire       uart_line;
    wire       tx_busy;

    wire [7:0] rx_data_out;
    wire       rx_data_valid;
    wire       rx_busy;
    wire       parity_error;
    wire       frame_error;

    uart_top #(
        .CLK_FREQ      (CLK_FREQ),
        .BAUD_RATE     (BAUD_RATE),
        .PARITY_ENABLE (1'b1),
        .ODD_PARITY    (1'b0)   // Even parity
    ) dut (
        .clk           (clk),
        .rst_n         (rst_n),

        .tx_data_in    (tx_data_in),
        .tx_start      (tx_start),
        .tx             (uart_line),
        .tx_busy        (tx_busy),

        .rx             (uart_line), // Loopback: TX connected to RX
        .rx_data_out    (rx_data_out),
        .rx_data_valid  (rx_data_valid),
        .rx_busy        (rx_busy),
        .parity_error   (parity_error),
        .frame_error    (frame_error)
    );

    // 1 MHz clock: 1000 ns period
    always #500 clk = ~clk;

    task send_byte;
        input [7:0] byte_data;
        begin
            wait (tx_busy == 1'b0);

            @(negedge clk);
            tx_data_in = byte_data;
            tx_start   = 1'b1;

            // tx_start is high for one clock period
            @(negedge clk);
            tx_start = 1'b0;

            wait (tx_busy == 1'b1);
            wait (tx_busy == 1'b0);

            repeat (20) @(posedge clk);
        end
    endtask

    initial begin
        clk        = 1'b0;
        rst_n      = 1'b0;
        tx_data_in = 8'h00;
        tx_start   = 1'b0;

        #5000;
        rst_n = 1'b1;

        send_byte(8'h55);
        send_byte(8'hA3);
        send_byte(8'hC7);

        #100_000;
        $finish;
    end

    always @(posedge clk) begin
        if (rx_data_valid) begin
            $display(
                "Time = %0t | Sent/Received = %h | Parity Error = %b | Frame Error = %b",
                $time, rx_data_out, parity_error, frame_error
            );
        end
    end

    initial begin
        $dumpfile("uart_top_tb.vcd");
        $dumpvars(0, uart_top_tb);
    end

endmodule
